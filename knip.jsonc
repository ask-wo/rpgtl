{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["systemd-run", "setsid", "Xvfb"],
  "workspaces": {
    ".": {
      "entry": [
        // The verify-rpgtl skill's scripts are run by hand.
        ".agents/skills/*/{scripts,examples}/*.ts",
        // `pnpm run e2e` runs Playwright with this config.
        "e2e/playwright.config.ts",
      ],
    },
    "apps/server": {
      // The tests run these by path in place of the codex and claude CLIs and llama-server.
      "entry": [
        "src/testUtils/fakeCodex.ts",
        "src/testUtils/fakeClaude.ts",
        "src/testUtils/fakeLlamaServer.ts",
        // The portable download's server, which src/buildArchive.ts bundles.
        "src/portable.ts",
      ],
      // src/frontend/Frontend.ts builds the page from @rpgtl/web's folder, and
      // src/imageText/XpImages.ts finds the font files by path.
      "ignoreDependencies": ["@rpgtl/web", "@fontsource/noto-sans", "@fontsource/noto-serif"],
    },
    "packages/game": {
      // src/build.ts builds the game scripts from these by path.
      "entry": ["src/runtime/index.ts", "src/mapView/index.ts", "src/nwjsHook/index.ts"],
    },
    "apps/web": {
      // Components copied in from shadcn/ui keep all their parts, used or not.
      "ignoreIssues": { "src/components/ui/**": ["exports"] },
    },
  },
}
